# script-src pins the pages' shared inline <head> script by SHA-256; recompute it whenever that script changes (see docs/launch/website-deploy.md).
# It also allows Cloudflare Web Analytics' beacon host: Cloudflare injects the beacon at the edge (automatic setup) from a versioned path (/beacon.min.js/v<hash>, pinned by an integrity attribute), so a source naming the bare file would not match. It reports to this site's own /cdn-cgi/rum, which connect-src 'self' covers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-ZnYJX5ypMaaAhxxWhSEjbMkhO2A9yPmbzEQH3LFaITA=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/assets/fonts/*
  Cache-Control: public, max-age=2592000

# The installer is fetched by curl and read in browsers; serve it as plain text and never stale.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
