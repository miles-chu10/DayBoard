{
  // Serves ../website as static assets on getdayboard.com. Deploy from this folder: npx wrangler deploy
  "name": "dayboard-website",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "../website",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only video runs the Worker first (Safari needs byte ranges). Pages, CSS, scripts and images
    // are served as static assets, which are free and don't count toward the Workers request limit.
    // The http-to-https and www-to-apex redirects for those come from the zone's Always Use HTTPS
    // setting and a www redirect rule (docs/launch/website-deploy.md, "Redirects").
    "run_worker_first": ["/*.mp4"],
  },
  "routes": [
    { "pattern": "getdayboard.com", "custom_domain": true },
    { "pattern": "www.getdayboard.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
